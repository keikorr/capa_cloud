# --- Segurança adicionada na auditoria de pagamentos (18/08/2026) -----------------
# Sem CAPAXERO_ADMIN_PASSWORD, o login do painel (/upus_APP/app/Register/login1) fica
# bloqueado — antes ele aceitava qualquer usuário/senha. Defina uma senha real aqui.
CAPAXERO_ADMIN_PASSWORD=

# Protege /api/v1/admin/* (destravar porta, parada de emergência, ciclo remoto). Se ficar
# vazio, um token temporário é gerado a cada boot e impresso no console do servidor.
CAPAXERO_ADMIN_TOKEN=123456

# Protege POST /api/v1/payment/cielo/webhook contra aprovações forjadas. Cadastre a URL do
# webhook na Cielo já com "?token=<este valor>". Se ficar vazio, um token temporário é
# gerado a cada boot e impresso no console do servidor.
CAPAXERO_WEBHOOK_TOKEN=

# Origens extras liberadas no CORS além da rede local (localhost/10.x/172.16-31.x/192.168.x),
# separadas por vírgula. Ex.: https://dashboard.capaxero.com.br
CAPAXERO_CORS_ORIGINS=
